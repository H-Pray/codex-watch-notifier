{
  "description": "Capture Codex prompts and notify on approval requests and completion.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 /absolute/path/to/codex-watch-notifier/scripts/codex_complete.py --env-file /absolute/path/to/codex-watch-notifier/.env --provider ntfy",
            "timeout": 5
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 /absolute/path/to/codex-watch-notifier/scripts/codex_complete.py --env-file /absolute/path/to/codex-watch-notifier/.env --provider ntfy",
            "timeout": 15,
            "statusMessage": "Sending Codex approval notification"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 /absolute/path/to/codex-watch-notifier/scripts/codex_complete.py --env-file /absolute/path/to/codex-watch-notifier/.env --provider ntfy",
            "timeout": 15,
            "statusMessage": "Sending Codex completion notification"
          }
        ]
      }
    ]
  }
}
