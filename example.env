# Comma-separated providers: ntfy, desktop, telegram
NOTIFICATION_PROVIDERS=ntfy

# ntfy is the recommended phone/Apple Watch provider. Use a hard-to-guess topic.
NTFY_SERVER_URL=https://ntfy.sh
NTFY_TOPIC=replace-with-a-private-random-topic
NTFY_TOKEN=
NTFY_PRIORITY=default

# Optional legacy provider; required only when telegram is enabled.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Local Codex CLI integration. Change these if your executable or invocation differs.
CODEX_COMMAND=codex
CODEX_ARGS=exec

# Optional notification title.
CODEX_WATCH_TITLE=Codex Watch

# Apple Watch approval actions. Timeout leaves the normal Codex prompt intact.
CODEX_WATCH_APPROVALS=true
CODEX_APPROVAL_TIMEOUT=300
