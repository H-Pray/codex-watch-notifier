# Comma-separated providers: desktop, telegram
NOTIFICATION_PROVIDERS=desktop

# Required only when telegram is enabled.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Local Codex CLI integration. Change these if your executable or invocation differs.
CODEX_COMMAND=codex
CODEX_ARGS=exec

# Optional notification title.
CODEX_WATCH_TITLE=Codex Watch
